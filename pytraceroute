#!/usr/bin/env python3
"""
pytraceroute_enhanced.py

Enhancements:
- ICMP / UDP probes with matching via ICMP payload parsing
- TCP SYN probes via non-blocking connect (TTL set on socket)
- Pipelined parallelization across TTLs (windowed)
- Async DNS reverse lookups (threadpool)
- Better privilege detection (Unix + Windows)
- Responsive to Ctrl+C (time-sliced select)
- 2-space indentation
"""

from __future__ import annotations
import argparse
import concurrent.futures
import errno
import os
import socket
import struct
import select
import sys
import time
from typing import Dict, List, Optional, Tuple

# ICMP types
ICMP_ECHO_REQUEST = 8
ICMP_ECHO_REPLY = 0
ICMP_TIME_EXCEEDED = 11
ICMP_DEST_UNREACH = 3

# Defaults
DEFAULT_MAX_HOPS = 30
DEFAULT_PROBES = 3
DEFAULT_TIMEOUT = 2.0
DEFAULT_SELECT_CHUNK = 0.15
DEFAULT_PIPELINE = 4  # number of TTLs to pipeline (parallel window)
DEFAULT_TCP_PORT = 80

# ------------------------------------------------------------
# Utilities
# ------------------------------------------------------------
def is_privileged() -> bool:
  """Return True if running with privileges to open raw sockets.
  Works on Unix (geteuid) and Windows (IsUserAnAdmin via ctypes)"""
  try:
    if hasattr(os, 'geteuid'):
      return os.geteuid() == 0
    # on Windows try shell32.IsUserAnAdmin
    import ctypes
    try:
      return ctypes.windll.shell32.IsUserAnAdmin() != 0
    except Exception:
      return False
  except Exception:
    return False

def checksum(data: bytes) -> int:
  if len(data) % 2:
    data += b'\x00'
  s = 0
  for i in range(0, len(data), 2):
    s += data[i] << 8 | data[i+1]
  s = (s >> 16) + (s & 0xffff)
  s += s >> 16
  return ~s & 0xffff

def build_icmp_echo(identifier: int, sequence: int, payload: bytes = b'') -> bytes:
  hdr = struct.pack('!BBHHH', ICMP_ECHO_REQUEST, 0, 0, identifier, sequence)
  chk = checksum(hdr + payload)
  hdr = struct.pack('!BBHHH', ICMP_ECHO_REQUEST, 0, chk, identifier, sequence)
  return hdr + payload

def ip_header_len_from_packet(pkt: bytes) -> int:
  # first byte: version(4bits) | IHL(4bits)
  ihl = pkt[0] & 0x0f
  return ihl * 4

# ------------------------------------------------------------
# Probe metadata & reply matching
# ------------------------------------------------------------
# We'll generate unique sequence numbers for ICMP probes and unique UDP destination ports for UDP probes derived from seq.
# For TCP probes, we track the socket object and match connect completion ourselves.

class ProbeInfo:
  """Information about a sent probe used to match replies."""
  def __init__(self, proto: str, ttl: int, probe_idx: int, seq: int, sent_time: float, udp_port: Optional[int]=None):
    self.proto = proto  # 'icmp'|'udp'|'tcp'
    self.ttl = ttl
    self.probe_idx = probe_idx
    self.seq = seq
    self.sent_time = sent_time
    self.udp_port = udp_port

# ------------------------------------------------------------
# Tracer implementation (pipelined)
# ------------------------------------------------------------
class Tracer:
  def __init__(self,
               destination: str,
               max_hops: int = DEFAULT_MAX_HOPS,
               probes: int = DEFAULT_PROBES,
               timeout: float = DEFAULT_TIMEOUT,
               use_icmp: bool = True,
               force_udp: bool = False,
               use_tcp: bool = False,
               tcp_port: int = DEFAULT_TCP_PORT,
               pipeline: int = DEFAULT_PIPELINE,
               select_chunk: float = DEFAULT_SELECT_CHUNK,
               no_dns: bool = False,
               async_dns: bool = True,
               concurrency_limit: int = 8):
    self.destination = destination
    self.dest_addr = socket.gethostbyname(destination)
    self.max_hops = max_hops
    self.probes = probes
    self.timeout = timeout
    self.select_chunk = select_chunk
    self.pipeline = max(1, int(pipeline))
    self.no_dns = no_dns
    self.async_dns = async_dns
    self.tcp_port = tcp_port
    self.use_tcp = use_tcp
    # decide icmp usage by privilege and user choice
    self.use_icmp = use_icmp and is_privileged() and not force_udp
    self.force_udp = force_udp
    self._recv_sock = None  # raw ICMP recv socket (if available)
    self._send_udp_sock = None  # UDP send socket
    self._id_base = os.getpid() & 0xffff
    self._seq_counter = 1
    self._probe_map: Dict[int, ProbeInfo] = {}  # seq -> ProbeInfo (for icmp/udp)
    self._udp_port_map: Dict[int, int] = {}  # udp_port -> seq
    self._tcp_sockets = {}  # sock -> (ttl, probe_idx, sent_time)
    self._dns_executor = None if not async_dns else concurrent.futures.ThreadPoolExecutor(max_workers=6)
    self._concurrency_limit = concurrency_limit

  def _next_seq(self) -> int:
    s = self._seq_counter
    self._seq_counter += 1
    # wrap a bit to keep numbers small
    if self._seq_counter > 0x7fff:
      self._seq_counter = 1
    return s

  def _create_sockets(self):
    # raw ICMP receive socket (for ICMP replies)
    try:
      self._recv_sock = socket.socket(socket.AF_INET, socket.SOCK_RAW, socket.getprotobyname('icmp'))
      self._recv_sock.setblocking(False)
    except PermissionError:
      self._recv_sock = None
    except Exception:
      self._recv_sock = None

    # UDP send socket (non-privileged)
    try:
      self._send_udp_sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_UDP)
      self._send_udp_sock.setblocking(False)
    except Exception:
      self._send_udp_sock = None

  def _close_sockets(self):
    try:
      if self._recv_sock:
        self._recv_sock.close()
    except Exception:
      pass
    try:
      if self._send_udp_sock:
        self._send_udp_sock.close()
    except Exception:
      pass
    for s in list(self._tcp_sockets.keys()):
      try:
        s.close()
      except Exception:
        pass
    self._tcp_sockets.clear()

  # ------------------------------------------------------------
  # Send probe helpers
  # ------------------------------------------------------------
  def _send_icmp_probe(self, ttl: int, probe_idx: int) -> int:
    """Send an ICMP echo request with given TTL. Return seq."""
    seq = self._next_seq()
    payload = struct.pack('!dI', time.time(), seq)  # embed time + seq in payload
    pkt = build_icmp_echo(self._id_base, seq, payload)
    # send via raw socket - we create a raw socket for sending or reuse recv if available
    try:
      s = socket.socket(socket.AF_INET, socket.SOCK_RAW, socket.getprotobyname('icmp'))
      s.setsockopt(socket.SOL_IP, socket.IP_TTL, ttl)
      s.sendto(pkt, (self.dest_addr, 0))
      s.close()
    except Exception as e:
      # if send fails, fall back to UDP (caller may handle)
      # but still return seq so it won't block mapping
      pass
    self._probe_map[seq] = ProbeInfo('icmp', ttl, probe_idx, seq, time.time())
    return seq

  def _send_udp_probe(self, ttl: int, probe_idx: int) -> int:
    """Send a UDP probe to dest at unique port (derived from seq). Return seq."""
    seq = self._next_seq()
    # craft a unique destination port for this seq (range 33434-33534 etc.)
    base = 33434
    udp_port = base + (seq % 20000)  # keep within ephemeral safeish range
    try:
      # set TTL on the socket (create a new socket per probe so TTL is per-probe)
      s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_UDP)
      s.setsockopt(socket.SOL_IP, socket.IP_TTL, ttl)
      # send empty payload to dest at chosen port
      s.sendto(b'', (self.dest_addr, udp_port))
      s.close()
    except Exception:
      pass
    self._probe_map[seq] = ProbeInfo('udp', ttl, probe_idx, seq, time.time(), udp_port=udp_port)
    self._udp_port_map[udp_port] = seq
    return seq

  def _start_tcp_probe(self, ttl: int, probe_idx: int) -> socket.socket:
    """Start a non-blocking TCP connect for TTL; return the socket object which we track."""
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.setblocking(False)
    try:
      s.setsockopt(socket.SOL_IP, socket.IP_TTL, ttl)
    except Exception:
      # non-fatal
      pass
    # initiate non-blocking connect
    try:
      s.connect((self.dest_addr, self.tcp_port))
    except BlockingIOError:
      # expected for non-blocking
      pass
    except Exception:
      # connect may raise immediate errors (e.g., network unreachable)
      pass
    self._tcp_sockets[s] = (ttl, probe_idx, time.time())
    return s

  # ------------------------------------------------------------
  # Reply parsing / matching
  # ------------------------------------------------------------
  def _parse_icmp_packet(self, pkt: bytes) -> Optional[Tuple[str, int, float]]:
    """
    Parse raw IP packet containing ICMP.
    Return (src_ip, matched_seq, receive_time) if matched to a probe, otherwise None.
    """
    recv_time = time.time()
    try:
      ihl = ip_header_len_from_packet(pkt)
      icmp_off = ihl
      icmp_type = pkt[icmp_off]
      # icmp header: type(1), code(1), checksum(2), rest (4)
      if icmp_type == ICMP_ECHO_REPLY:
        # echo reply contains id and seq directly after type/code/chk
        _, _, _, identifier, seq = struct.unpack('!BBHHH', pkt[icmp_off:icmp_off+8])
        # verify identifier matches our id_base
        if identifier == self._id_base and seq in self._probe_map:
          return (None, seq, recv_time)
      elif icmp_type in (ICMP_TIME_EXCEEDED, ICMP_DEST_UNREACH):
        # payload includes original IP header + first 8 bytes of original datagram
        inner_off = icmp_off + 8  # skip icmp header
        # safety check
        if len(pkt) >= inner_off + 20:
          # original IP header
          inner_ihl = (pkt[inner_off] & 0x0f) * 4
          # original protocol
          proto = pkt[inner_off + 9]
          if proto == socket.IPPROTO_UDP:
            # UDP header follows original IP header
            udp_off = inner_off + inner_ihl
            if len(pkt) >= udp_off + 8:
              orig_dst_port = struct.unpack('!H', pkt[udp_off+2:udp_off+4])[0]
              # map dest port to seq
              seq = self._udp_port_map.get(orig_dst_port)
              if seq is not None:
                return (None, seq, recv_time)
          elif proto == socket.IPPROTO_ICMP:
            # original ICMP message contained id/seq (for our ICMP probes)
            icmp_inner_off = inner_off + inner_ihl
            if len(pkt) >= icmp_inner_off + 8:
              _, _, _, identifier, seq = struct.unpack('!BBHHH', pkt[icmp_inner_off:icmp_inner_off+8])
              if identifier == self._id_base and seq in self._probe_map:
                return (None, seq, recv_time)
          # else: could be TCP or other; we don't parse here
    except Exception:
      pass
    return None

  # ------------------------------------------------------------
  # Core pipelined loop
  # ------------------------------------------------------------
  def run(self):
    print(f"Traceroute to {self.destination} ({self.dest_addr}), max hops {self.max_hops}, probes {self.probes}, timeout {self.timeout}s")
    self._create_sockets()
    if self.use_icmp and self._recv_sock is None:
      print("Warning: ICMP requested but raw sockets unavailable; ICMP disabled.")
      self.use_icmp = False

    # options: if user forced UDP, disable icmp/tcp
    if self.force_udp:
      self.use_icmp = False

    # pipeline windows: we probe TTLs in batches of size pipeline
    next_ttl = 1
    reached = False

    try:
      while next_ttl <= self.max_hops:
        # build a window of TTLs
        window = list(range(next_ttl, min(self.max_hops + 1, next_ttl + self.pipeline)))
        # for each ttl in window, send probes (and for tcp start non-blocking connects)
        expected_probes = 0
        for ttl in window:
          for pidx in range(self.probes):
            expected_probes += 1
            if self.use_icmp:
              self._send_icmp_probe(ttl, pidx)
            elif self.use_tcp:
              # for tcp mode, start non-blocking connect
              self._start_tcp_probe(ttl, pidx)
            else:
              # UDP fallback
              self._send_udp_probe(ttl, pidx)

        # collect replies for the whole window within the timeout
        tstart_window = time.time()
        remaining = self.timeout
        got_seqs = set()
        # map ttl -> list of (ip, rtt)
        window_results: Dict[int, List[Tuple[str, float]]] = {ttl: [] for ttl in window}

        # For TCP probes we will track socket completion using select for writability
        tcp_socks = list(self._tcp_sockets.keys())

        while remaining > 0 and (len(got_seqs) < expected_probes or (tcp_socks and any(sock.fileno() != -1 for sock in tcp_socks))):
          chunk = min(self.select_chunk, remaining)

          readers = []
          writers = []
          if self._recv_sock is not None:
            readers.append(self._recv_sock)
          # include tcp sockets for writability checks
          if tcp_socks:
            writers.extend(tcp_socks)

          try:
            rlist, wlist, _ = select.select(readers, writers, [], chunk)
          except InterruptedError:
            raise KeyboardInterrupt
          except Exception:
            rlist, wlist = [], []

          # process ICMP recv if available
          if rlist:
            for rsock in rlist:
              try:
                pkt, addr = rsock.recvfrom(65535)
                recv_time = time.time()
                src = addr[0]
                parsed = self._parse_icmp_packet(pkt)
                if parsed:
                  _, seq, rcv_t = parsed
                  pi = self._probe_map.get(seq)
                  if pi and seq not in got_seqs:
                    rtt = rcv_t - pi.sent_time
                    window_results[pi.ttl].append((src, rtt))
                    got_seqs.add(seq)
              except BlockingIOError:
                pass
              except Exception:
                # ignore invalid packets
                pass

          # process tcp sockets writability (connect completion or error)
          if wlist:
            for wsock in list(wlist):
              try:
                err = wsock.getsockopt(socket.SOL_SOCKET, socket.SO_ERROR)
                ttl, pidx, sent_time = self._tcp_sockets.get(wsock, (None, None, None))
                if ttl is None:
                  # unknown socket; remove
                  try:
                    wsock.close()
                  except Exception:
                    pass
                  tcp_socks.remove(wsock)
                  self._tcp_sockets.pop(wsock, None)
                  continue
                rtt = time.time() - sent_time
                # interpret err: 0 -> connected, ECONNREFUSED -> remote closed (still reached)
                if err == 0 or err == errno.ECONNREFUSED:
                  # treat as response from dest (but only if ttl values indicate dest)
                  # If ttl is equal to the destination TTL (i.e., we just connected to dest), we mark dest reached
                  # Note: non-trivial to know whether the socket reached intermediate hops (most OS won't give us ICMP TTL exceeded here)
                  window_results[ttl].append((self.dest_addr, rtt))
                else:
                  # other err — treat as some response (e.g., network unreachable) and record
                  window_results[ttl].append((self.dest_addr, rtt))
                got_seqs.add(('tcp', ttl, pidx, id(wsock)))
                # close socket and cleanup
                try:
                  wsock.close()
                except Exception:
                  pass
                tcp_socks.remove(wsock)
                self._tcp_sockets.pop(wsock, None)
              except Exception:
                # remove dirty socket
                try:
                  wsock.close()
                except Exception:
                  pass
                tcp_socks.remove(wsock)
                self._tcp_sockets.pop(wsock, None)

          remaining = self.timeout - (time.time() - tstart_window)

        # After collection window, print results for each TTL in the window
        for ttl in window:
          entries = window_results.get(ttl, [])
          if not entries:
            print(f"{ttl:2d}  * * *")
          else:
            # dedupe addresses and present first replies
            seen = set()
            parts = []
            for ip, rtt in entries:
              if ip in seen:
                continue
              seen.add(ip)
              if not self.no_dns and self.async_dns and self._dns_executor:
                # schedule async resolution and print ip+rtt; resolved names will print later
                parts.append(f"{ip} {rtt:.3f}s")
                self._dns_executor.submit(self._async_dns_print, ip, ttl, rtt)
              elif not self.no_dns:
                # synchronous (may block) unless user disabled
                try:
                  name = socket.gethostbyaddr(ip)[0]
                  parts.append(f"{name} ({ip}) {rtt:.3f}s")
                except Exception:
                  parts.append(f"{ip} {rtt:.3f}s")
              else:
                parts.append(f"{ip} {rtt:.3f}s")
            print(f"{ttl:2d}  " + "  ".join(parts))
            # If destination addr appears in answers for this TTL -> reached
            if any(ip == self.dest_addr for ip, _ in entries):
              print("Destination reached.")
              reached = True
              break

        if reached:
          break

        # advance next_ttl
        next_ttl = window[-1] + 1

    except KeyboardInterrupt:
      print("\nUser interrupted.")
    finally:
      self._close_sockets()
      if self._dns_executor:
        try:
          self._dns_executor.shutdown(wait=False)
        except Exception:
          pass

    if not reached:
      print("Traceroute finished without reaching destination.")

  # Async DNS resolver to print resolved name later
  def _async_dns_print(self, ip: str, ttl: int, rtt: float):
    try:
      name = socket.gethostbyaddr(ip)[0]
      print(f"  (resolved) {ttl:2d}  {name} ({ip}) {rtt:.3f}s")
    except Exception:
      # ignore failures
      pass

# ------------------------------------------------------------
# CLI & glue
# ------------------------------------------------------------
def parse_args(argv: Optional[List[str]] = None):
  p = argparse.ArgumentParser(description='pytraceroute_enhanced - ICMP/UDP/TCP traceroute with pipeline & async DNS')
  p.add_argument('host', help='destination hostname or IP')
  p.add_argument('-m', '--max-hops', type=int, default=DEFAULT_MAX_HOPS, help='maximum hops (default 30)')
  p.add_argument('-q', '--probes', type=int, default=DEFAULT_PROBES, help='probes per hop (default 3)')
  p.add_argument('-w', '--wait', type=float, default=DEFAULT_TIMEOUT, help='per-window timeout seconds (default 2.0)')
  p.add_argument('--udp', action='store_true', help='force UDP probes (do not use ICMP echo)')
  p.add_argument('--icmp', action='store_true', help='prefer ICMP probes (requires admin)')
  p.add_argument('--tcp', action='store_true', help='enable TCP SYN/connect probes')
  p.add_argument('--tcp-port', type=int, default=DEFAULT_TCP_PORT, help='destination TCP port for TCP probes (default 80)')
  p.add_argument('--pipeline', type=int, default=DEFAULT_PIPELINE, help='number of TTLs to pipeline (window size)')
  p.add_argument('--select-chunk', type=float, default=DEFAULT_SELECT_CHUNK, help='select time slice in seconds (default 0.15)')
  p.add_argument('--no-dns', action='store_true', help='do not perform reverse DNS lookups')
  p.add_argument('--no-async-dns', dest='async_dns', action='store_false', help='disable async DNS (use blocking DNS or none if --no-dns)')
  return p.parse_args(argv)

def main(argv: Optional[List[str]] = None):
  args = parse_args(argv)
  # choose probe mode priority: if --icmp requested, try to use it (if privileged)
  use_icmp = args.icmp
  force_udp = args.udp
  use_tcp = args.tcp
  try:
    t = Tracer(destination=args.host,
               max_hops=args.max_hops,
               probes=args.probes,
               timeout=args.wait,
               use_icmp=use_icmp,
               force_udp=force_udp,
               use_tcp=use_tcp,
               tcp_port=args.tcp_port,
               pipeline=args.pipeline,
               select_chunk=args.select_chunk,
               no_dns=args.no_dns,
               async_dns=args.async_dns)
    t.run()
  except Exception as e:
    print("Error:", e, file=sys.stderr)
    sys.exit(2)

if __name__ == '__main__':
  main()